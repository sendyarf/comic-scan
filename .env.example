# ComicScan config — salin ke .env lalu isi nilainya.
# .env JANGAN di-commit (sudah ada di .gitignore).

# URL embedding API (llama-server). Pakai 127.0.0.1 jika website & API satu mesin.
EMBED_URL=http://127.0.0.1:8080/v1/embeddings
# API key llama-server (--api-key). Header: Authorization: Bearer <key>
EMBED_API_KEY=

# URL Qdrant
QDRANT_URL=http://127.0.0.1:6333
# API key Qdrant (QDRANT__SERVICE__API_KEY). Header: api-key: <key>
QDRANT_API_KEY=
QDRANT_COLLECTION=komik_panels

# Database SQLite scraper (untuk metadata AniList)
SCRAPER_DB=/home/hatch/workspace/komik-scraper/scraper.db

# Port website
PORT=8000
